# Ignore node_modules directory
node_modules/

    # Ignore build output
    dist/
    build/

    # Ignore IDE-specific files (e.g., WebStorm's .idea folder, but Git handles this automatically with a separate .idea/.gitignore)
    # .idea/

    # Ignore log files
    *.log

    # Ignore temporary files
    *.tmp

# Explicitly include compiled dist folder (compiled output is committed)
!/dist/

# Note: node_modules/ is ignored (line 2) and should NEVER be committed
# !/.env is commented out - .env files should not be committed for security
