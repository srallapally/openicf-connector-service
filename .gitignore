# Ignore node_modules directory
node_modules/

# Ignore build output. Packages publish dist via their "files" field, which
# reads from disk at pack time -- it does not need to be tracked in git.
dist/
build/
*.tsbuildinfo

# Ignore IDE-specific files (e.g., WebStorm's .idea folder, but Git handles this automatically with a separate .idea/.gitignore)
# .idea/

# Ignore log files
*.log

# Ignore temporary files
*.tmp

# Note: node_modules/ is ignored (line 2) and should NEVER be committed
# .env files should not be committed for security
